# ── Geoventra environment ─────────────────────────────────────────────────────
# Copy to .env and adjust. The API reads these variables at startup.

# PostgreSQL connection string. The API pins the search_path to the `geoventra`
# schema automatically; do not change it unless you also migrate the data.
DATABASE_URL=postgresql://geoventra@localhost:5432/geoventra
DATABASE_SCHEMA=geoventra
TEST_DATABASE_URL=postgresql://geoventra@localhost:5432/geoventra_test

# API port and CORS origin for the web client.
PORT=4000
CORS_ORIGIN=http://localhost:3000

# JWT secrets. Generate fresh values for any real deployment; the defaults below
# are for local development only.
JWT_ACCESS_SECRET=geoventra-development-access-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_SECRET=geoventra-development-refresh-secret
JWT_REFRESH_TTL_SECONDS=1209600

# Shared secret used by telemetry gateways and the GPS simulator to authenticate
# against the ingestion endpoints (x-ingest-key header).
INGEST_SHARED_SECRET=geoventra-development-ingest-key

# Redis (reserved for future realtime fan-out; not required to run locally).
REDIS_URL=redis://localhost:6379

# Public client configuration.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_MAP_PROVIDER=maplibre

# Simulator control.
SIMULATOR_ADMIN_URL=http://localhost:8085
SIMULATOR_ADMIN_KEY=geoventra-development-ingest-key

# PT06 GPS tracker TCP listener.
PT06_TCP_PORT=5001

# PS10 (Pictor) GPS tracker TCP listener. Defaults to port 5002; use a distinct
# port from PT06 because both listeners bind at startup.
PS10_TCP_PORT=5002
PS10_TCP_HOST=0.0.0.0
PS10_TCP_TIMEOUT_MS=180000
PS10_MAX_CONNECTIONS=200
PS10_RATE_LIMIT_PER_MINUTE=120

# Notification infrastructure.
NOTIFICATION_MASTER_KEY=geoventra-development-master-key
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=2000
NOTIFICATION_WORKER_CONCURRENCY=4
DEV_PROVIDER_MODE=success
ENABLE_DEV_PROVIDERS=false
WEBHOOK_SECRET=
PT06_TCP_HOST=0.0.0.0
PT06_TCP_TIMEOUT_MS=180000
PT06_MAX_CONNECTIONS=200
PT06_RATE_LIMIT_PER_MINUTE=120
