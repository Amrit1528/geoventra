{
  "name": "@geoventra/api",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "predev": "tsc -p tsconfig.json",
    "dev": "node --watch dist/main.js",
    "watch": "tsc -p tsconfig.json --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:migrate": "tsx ../../database/migrate.ts",
    "db:seed": "tsx ../../database/seeds/seed.ts",
    "db:setup": "pnpm db:migrate && pnpm db:seed",
    "db:reset": "tsx ../../database/reset.ts"
  },
  "dependencies": {
    "@geoventra/contracts": "workspace:*",
    "@geoventra/validation": "workspace:*",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/platform-socket.io": "^10.4.15",
    "@nestjs/swagger": "^7.4.2",
    "@nestjs/websockets": "^10.4.15",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.11.3",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nestjs/testing": "^10.4.15",
    "@swc-node/register": "^1.12.1",
    "@swc/core": "^1.16.22",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.11.6",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.15.5",
    "typescript": "5.9.3",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "mqtt": "^5.10.1"
  }
}
